PORT=5000
# Local:
# MONGODB_URI=mongodb://127.0.0.1:27017/shewacraft
# Atlas (replace user, password, cluster, and db name):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shewacraft?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shewacraft
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
JWT_EXPIRES_IN_REMEMBER=7d
CORS_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@shewacraft.com
ADMIN_PASSWORD=change-this-admin-password
CLIENT_URL=http://localhost:5173
# Optional. Defaults to ./uploads
# UPLOAD_DIR=
# Product and payment-proof image uploads (signed server-side).
# Missing any of these → 503 on POST /api/uploads/images and POST /api/orders
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Gmail SMTP for password-reset emails (App Password, not the account password).
# Missing either → 503 on POST /api/auth/forgot-password
# SMTP_USER=
# SMTP_PASS=
# Optional. Must be a real address, e.g. ShewaCraft <you@gmail.com>
# MAIL_FROM=
NODE_ENV=development
